{
  "Stylelint SCSS config": {
    "prefix": "stylelint-scss",
    "body": [
      "{",
      "\t\"extends\": [\"stylelint-config-standard-scss\"],",
      "\t\"plugins\": [\"stylelint-order\"],",
      "\t\"rules\": {",
      "\t\t\"max-nesting-depth\": ${1:3},",
      "\t\t\"selector-max-compound-selectors\": ${2:4},",
      "\t\t\"selector-class-pattern\": \"^[a-z][a-z0-9]*(-[a-z0-9]+)*(__[a-z0-9]+(-[a-z0-9]+)*)?(--[a-z0-9]+(-[a-z0-9]+)*)?\\$\",",
      "\t\t\"scss/dollar-variable-pattern\": \"^[a-z][a-z0-9]*(-[a-z0-9]+)*\\$\",",
      "\t\t\"scss/at-mixin-pattern\": \"^[a-z][a-z0-9]*(-[a-z0-9]+)*\\$\",",
      "\t\t\"scss/load-no-partial-leading-underscore\": true,",
      "\t\t\"scss/at-use-no-redundant-alias\": true,",
      "\t\t\"no-descending-specificity\": null,",
      "\t\t\"order/properties-alphabetical-order\": true",
      "\t},",
      "\t\"ignoreFiles\": [\"dist/**\", \"node_modules/**\"]",
      "}$0"
    ],
    "description": "Stylelint config for SCSS (standard-scss + BEM patterns)"
  }
}
